# ============================================================
#  COPY THIS FILE AND RENAME THE COPY TO ".env"
#  Then put YOUR OWN MySQL username/password below.
#  This is the ONLY place you need to enter your MySQL password.
# ============================================================

DB_NAME=library_management
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_HOST=localhost
DB_PORT=3306

# You can leave this as-is, or change it to any random text.
SECRET_KEY=YOUR_DJANGO_SECRET_KEY
